# ---------------------------------------------------------------
# 数据: 不入库, 运行时获取 (见 THIRD-PARTY.md)
# 注意: .gitignore 不支持行尾注释, 规则必须独占一行
# ---------------------------------------------------------------
# IDS: ids_lv0/1/2.txt 与 ts.txt 来自 yi-bai/ids (MIT, 已入库); 下面三个来源待核/无 license
data/ids/component.txt
data/ids/ids_lv4.txt
data/ids/TangutIDS.txt
# 100+ MB, 超过 GitHub 单文件上限
web/public/core_glyphs.json
web/public/core_glyphs.json.bak
web/public/ids_lv*.txt
# 字体: 许可未查清, 用户自备
web/public/*.ttf

# 构建产物 / 依赖
web/dist/
web/node_modules/
node_modules/

# 实验用的渲染输出 (可重新生成, 只留在本地)
scripts/render*.html
# ---------------------------------------------------------------
# scripts/: 只保留「组字核心依赖链」+「生成词典/字库的脚本」
# 其余实验脚本只留本地, 不入库 (需要时把名字加到下面的放行列表)
# ---------------------------------------------------------------
scripts/*.py
# 组字核心: preview -> ids_anal -> cavity/central_box/glyph_extend/stroke_outer
!scripts/glyph_extend.py
!scripts/stroke_outer.py
!scripts/ids_anal.py
!scripts/cavity.py
!scripts/central_box.py
!scripts/central_box_old.py
!scripts/kage_contour.py
# 数据生成脚本
!scripts/unihan.py
!scripts/hangul.py
!scripts/extract_ipa.py
!scripts/extract_core_glyphs.py
# scripts/ 下的实验产物 (csv/png/svg 与 render 输出)
scripts/output/
scripts/render*
scripts/bezier_contour.svg

# 运行时必须随站点分发 (CI 构建时 public/ 会被拷进 dist)
!web/public/kage-bundle.js
!web/public/ids_lv0.txt
!web/public/ids_lv1.txt
!web/public/ids_lv2.txt
